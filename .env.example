# このファイルをコピーして「.env」という名前で保存し、値を書き換える
#   cp .env.example .env
# .env はトークンが入るので、人に送ったりGitにあげたりしないこと

# Graph APIエクスプローラで発行したアクセストークン
IG_TOKEN=ここにトークン

# python insta_fetch.py whoami を実行すると自動で入る
IG_USER_ID=

# 長期トークンへの交換（python insta_fetch.py extend）に使う
# アプリダッシュボード →「アプリの設定」→「ベーシック」の アプリID / app secret
FB_APP_ID=
FB_APP_SECRET=
